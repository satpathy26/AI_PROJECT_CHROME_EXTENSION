{
  "manifest_version": 3,
  "name": "AI MCQ Solver",
  "version": "1.0",

  "icons": {
    "16": "icons/logo.png",
    "32": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo.png",
      "32": "icons/logo.png",
      "48": "icons/logo.png",
      "128": "icons/logo.png"
    }
  },
   "permissions":["activeTab","scripting","tabs","storage"],
    "content_scripts":[{
    "matches":["<all_urls>"],
    "js" :["content.js"]
  }],
  "background": {
    "service_worker": "background.js",
    "type":"module"
}
}